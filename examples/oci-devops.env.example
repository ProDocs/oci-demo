AI_REVIEW_MODE=mock
AI_REVIEW_SCENARIO=auto
OCI_GENAI_AUTH_MODE=resource_principal
JAVA_HOME=/usr/lib64/graalvm/graalvm-java21

# Para ativar Oracle Generative AI de verdade no OCI DevOps, troque AI_REVIEW_MODE=oci
# e preencha os valores abaixo. No Managed Build, prefira OCI_GENAI_AUTH_MODE=resource_principal.
# OCI_GENAI_INFERENCE_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
# OCI_GENAI_COMPARTMENT_OCID=ocid1.compartment.oc1..exampleuniqueID
# OCI_GENAI_MODEL=meta.llama-3.1-70b-instruct
#
# Para rodar localmente com autenticacao OCI de usuario:
# OCI_GENAI_AUTH_MODE=user_principal
# OCI_CONFIG_PROFILE=DEFAULT
#
# Fallback legado por API key:
# OCI_GENAI_AUTH_MODE=api_key
# OCI_GENAI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
# OCI_GENAI_API_KEY=cole-sua-api-key-aqui
